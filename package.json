{
  "name": "xui-telegram-bot",
  "version": "2.0.0",
  "description": "Telegram-бот для пользователей 3x-ui (grammY + TypeScript), весь интерфейс в одном сообщении",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "qrcode": "^1.5.4",
    "undici": "^7.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
