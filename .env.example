# Токен бота от @BotFather (НЕ тот же, что во встроенном боте 3x-ui)
BOT_TOKEN=123456:ABC...

# Адрес панели вместе с webBasePath (Настройки панели → «Корневой путь URL»)
PANEL_URL=https://vpn.example.com/mysecretpath

# Вариант 1 (рекомендуется): API-токен — Настройки → Безопасность → API Token (scope admin)
API_TOKEN=
# Вариант 2: логин/пароль администратора (используется, если API_TOKEN пуст)
PANEL_USERNAME=admin
PANEL_PASSWORD=change_me
# Если в панели включена 2FA
PANEL_2FA_CODE=
# false — для самоподписанного сертификата
PANEL_VERIFY_SSL=true

# Базовый адрес подписки без subId. Пусто — бот возьмёт subURI из настроек панели
SUB_URL=

# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

TZ_NAME=Europe/Moscow

# ---------- Магазин (оплата переводом) ----------
# Магазин включается, когда заданы TARIFFS и PAYMENT_DETAILS (и есть ADMIN_IDS).
# Тарифы: название|дней|цена|ГБ (ГБ необязательно, пусто — безлимит), через ;
TARIFFS=1 месяц|30|150;3 месяца|90|400;12 месяцев|365|1400
CURRENCY=₽
# Реквизиты; перенос строки — \n
PAYMENT_DETAILS=Перевод по СБП: +7 900 000-00-00 (Т-Банк)\nПолучатель: Иван И.\nВ комментарии ничего не пишите
# Инбаунды для новых клиентов (id через запятую); пусто — все включённые
NEW_CLIENT_INBOUNDS=
NEW_CLIENT_LIMIT_IP=0
NEW_CLIENT_GROUP=

# ---------- Оформление ----------
# Пусто — берётся из настроек подписки панели (subTitle / subSupportUrl)
BOT_TITLE=
SUPPORT_URL=
# Названия серверов в «Статусе сервиса»
SERVER_NAME=🇷🇺 Россия
NODE_NAMES=germany=🇩🇪 Германия

# Уведомления
NOTIFY_ENABLED=true
NOTIFY_DAYS=3
NOTIFY_TRAFFIC_PERCENT=90
NOTIFY_INTERVAL_MIN=60

DATA_DIR=data
